# ~/.config/matugen/templates/git-delta.gitconfig
# Dynamically generated by Matugen

[delta]
    minus-style = syntax "{{colors.error_container.default.hex}}"
    minus-non-emph-style = syntax "{{colors.error_container.default.hex}}"
    minus-emph-style = bold syntax "{{colors.error.default.hex}}"
    plus-style = syntax "{{colors.primary_container.default.hex}}"
    plus-non-emph-style = syntax "{{colors.primary_container.default.hex}}"
    plus-emph-style = bold syntax "{{colors.primary.default.hex}}"
    file-style = bold "{{colors.primary.default.hex}}"
    file-decoration-style = "{{colors.outline.default.hex}}" ul
    hunk-header-decoration-style = "{{colors.outline_variant.default.hex}}" box
